{
  "permissions": {
    "allow": [
      "Bash(pip uninstall:*)",
      "Bash(PKG_CONFIG_PATH=\"/opt/homebrew/lib/pkgconfig\" pip install cairocffi cairosvg)",
      "Bash(python3:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(python consistency/generate_questions.py:*)",
      "Bash(python /tmp/check_success_count.py:*)",
      "Bash(python /tmp/check_indices.py:*)",
      "Bash(python:*)",
      "Bash(grep:*)",
      "Bash(xargs cat:*)"
    ],
    "deny": []
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx \"$CLAUDE_PROJECT_DIR/.claude/hooks/notification-desktop.ts\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
